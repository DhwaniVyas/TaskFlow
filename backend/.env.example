# TaskFlow Backend Environment Variables Example

# ==========================================
# Server Settings
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# Database Configuration
# ==========================================
# MongoDB Connection URI (e.g., Local URI or MongoDB Atlas SRV connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

# ==========================================
# JWT Session Configuration
# ==========================================
# Secret key used for signing JSON Web Tokens (use a long random alphanumeric string)
JWT_SECRET=your_jwt_signing_secret_here
# Session token expiration duration
JWT_EXPIRES_IN=20d

# ==========================================
# Client & Routing URLs
# ==========================================
# The main URL of the Vite client application (used for CORS mapping and email redirection links)
CLIENT_URL=http://localhost:5173
# Additional client URLs allowed for cross-origin calls (comma-separated list, optional)
CLIENT_URLS=http://localhost:5173,https://my-app.vercel.app
# Primary App base URL
APP_URL=http://localhost:5173

# ==========================================
# SMTP Email Configuration (Nodemailer)
# ==========================================
# SMTP mail server address (e.g. Brevo/Sendinblue: smtp-relay.brevo.com)
SMTP_HOST=smtp-relay.brevo.com
# Port for SMTP communication (typically 587 for TLS, or 465 for SSL)
SMTP_PORT=587
# Secure protocol flag ("true" for SSL on port 465, or "false" for TLS on port 587)
SMTP_SECURE=false
# Account user/login credential for SMTP server authentication
SMTP_USER=your_smtp_username_or_email
# Password or API token for SMTP server authentication
SMTP_PASS=your_smtp_password_or_key
# Sender identity address for outgoing mail alerts
MAIL_FROM=TaskFlow <noreply@taskflow.com>

# ==========================================
# Google Single Sign-On (SSO) OAuth
# ==========================================
# Google OAuth 2.0 Client ID (Get this from your Google Cloud Developer Console > Credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Google OAuth 2.0 Client Secret (Get this from your Google Cloud Developer Console > Credentials)
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ==========================================
# Twilio SMS Alerts Configuration (Optional)
# ==========================================
# Twilio Account SID (Found on Twilio Console dashboard. Falls back to mock logs if missing)
TWILIO_ACCOUNT_SID=
# Twilio Auth Token (Found on Twilio Console dashboard)
TWILIO_AUTH_TOKEN=
# Purchased Twilio SMS phone number (Include country code, e.g. +1234567890)
TWILIO_PHONE_NUMBER=
