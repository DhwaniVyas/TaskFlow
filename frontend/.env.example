# TaskFlow Frontend Environment Variables Example

# ==========================================
# API Connection Settings
# ==========================================
# The full base REST URL of your backend server API (e.g. http://localhost:5000/api in development)
VITE_API_URL=http://localhost:5000/api

# ==========================================
# Google Single Sign-On (SSO) OAuth
# ==========================================
# Google OAuth 2.0 Client ID (Must match the client ID configured on the backend server)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
